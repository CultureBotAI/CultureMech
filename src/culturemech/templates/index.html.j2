<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data: https:; font-src 'self'; object-src 'none'; base-uri 'none'">
<title>CultureMech — Media index</title>
<link rel="stylesheet" href="style.css">
<script src="record-theme.js"></script>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to record content</a>
<nav aria-label="Site navigation"><a href="{{ browser_href }}">Browse media</a> &middot; <a href="https://culturebotai.github.io/mechs/">All Mech projects</a></nav>
<header>
<h1>CultureMech — Media index</h1>
<p class="muted">{{ "{:,}".format(count) }} media records.</p>
{% if not composition_graphs_available %}
<p class="build-warning" role="status"><strong>Degraded build:</strong>
ingredient composition graphs are unavailable because the optional
<code>culturebotai-claw</code> renderer was not installed.</p>
{% endif %}
<p><a href="{{ growth_review_href }}">Media growth evidence review</a></p>
</header>
<main id="main-content">
{% for category, items in groups %}
<section>
<h2>{{ category }} <small class="muted">({{ items|length }})</small></h2>
<ul class="medium-index">
{% for item in items %}
<li><a href="{{ item.href }}"><code>{{ item.id }}</code></a>
<span class="muted">—</span> {{ item.name }}</li>
{% endfor %}
</ul>
</section>
{% endfor %}
</main>
<button class="theme-toggle" id="record-theme" type="button" aria-pressed="false">Dark mode</button>
</body>
</html>
