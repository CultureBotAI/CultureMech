<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data: https:; font-src 'self'; object-src 'none'; base-uri 'none'">
<title>{{ medium.name or medium.preferred_term }} ({{ medium.id }}) — CultureMech</title>
<link rel="stylesheet" href="{{ style_href }}">
{% if composition_graph %}
<script type="module" src="{{ mermaid_init_href }}"></script>
{% endif %}
<script src="{{ theme_href }}"></script>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to record content</a>

{% set app_base = (browser_href or '../app/browser.html') | replace('browser.html', '') %}
<nav class="breadcrumb site-nav" aria-label="Record navigation">
  <a href="{{ app_base }}index.html">Home</a> &middot;
  <a href="{{ browser_href }}">Browse media</a> &middot;
  <a href="{{ app_base }}text_map.html">Text Map</a> &middot;
  <a href="{{ app_base }}umap.html">Media PaCMAP</a> &middot;
  <a href="{{ app_base }}umap_graph.html">Media Graph</a> &middot;
  <a href="{{ app_base }}ingredient_umap.html">Ingredient PaCMAP</a> &middot;
  <a href="{{ app_base }}schema.html">Schema</a> &middot;
  <a href="{{ index_href }}">Media Index</a> &middot;
  <a href="https://culturebotai.github.io/mechs/">All Mech projects</a> &rsaquo;
  <span>{{ medium.id }}</span>
</nav>

<header>
  <div class="header-top">
    <div>
      <h1>{{ medium.name or medium.preferred_term }}</h1>
      <div class="meta">
        <span class="curie">{{ medium.id }}</span>
        {% if medium.category %}
          <span class="badge">{{ medium.category }}</span>
        {% endif %}
        {% if medium.medium_type %}
          <span class="badge">{{ medium.medium_type }}</span>
        {% endif %}
        {% if medium.physical_state %}
          <span class="badge">{{ medium.physical_state }}</span>
        {% endif %}
      </div>
      {% if medium.original_name and medium.original_name != medium.name %}
        <div class="muted">Original name: <em>{{ medium.original_name }}</em></div>
      {% endif %}
    </div>
    <form class="record-search" action="{{ browser_href or '../app/browser.html' }}" method="get" role="search">
      <input type="search" name="q" placeholder="Search media, ingredients, organisms..." aria-label="Search CultureMech media">
      <button type="submit">Search</button>
    </form>
  </div>
</header>

<main id="main-content">
{% include "_partials/overview.html.j2" %}
{% if composition_graph %}
<section id="composition">
<h2>Composition</h2>
{{ composition_graph|safe_mermaid }}
</section>
{% endif %}
{% include "_partials/ingredients.html.j2" %}
{% if medium.preparation_steps %}{% include "_partials/preparation.html.j2" %}{% endif %}
{% if medium.solutions %}{% include "_partials/solutions.html.j2" %}{% endif %}
{% if medium.datasets %}{% include "_partials/datasets.html.j2" %}{% endif %}
{% if medium.discussions %}{% include "_partials/discussions.html.j2" %}{% endif %}
{% include "_partials/scientific_details.html.j2" %}
{% include "_partials/provenance.html.j2" %}

</main>
<footer>
  <small class="muted">
    Generated from <code>{{ source_path }}</code> &middot;
    <a href="{{ app_base }}schema.html">LinkML Schema</a> &middot;
    <a href="{{ app_base }}recipes.json">JSON</a> / <a href="{{ app_base }}recipes.tsv">TSV</a> &middot;
    <a href="https://github.com/CultureBotAI/CultureMech">GitHub</a> &middot;
    BSD-3-Clause
  </small>
</footer>

<button class="theme-toggle" id="record-theme" type="button" aria-pressed="false">Dark mode</button>
</body>
</html>
