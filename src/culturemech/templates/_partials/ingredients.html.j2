{% from "_partials/quantity.html.j2" import quantity %}
{% set stock_composition = medium.composition is defined and medium.ingredients is not defined %}
{% set ingredients = medium.composition if stock_composition else medium.ingredients %}
<section id="ingredients">
<h2>{{ 'Stock composition' if stock_composition else 'Ingredients' }} <small class="muted">({{ ingredients|length }})</small></h2>
{% if ingredients %}
<table class="ingredients">
<thead>
<tr>
  <th>#</th>
  <th>Ingredient</th>
  <th class="right">Concentration</th>
  <th>Ontology</th>
  <th>Notes</th>
</tr>
</thead>
<tbody>
{% for ing in ingredients %}
<tr>
  <td class="right muted">{{ loop.index }}</td>
  <td>
    <strong>{{ ing.preferred_term }}</strong>
    {# Formula and mass come from the shared ChEBI term, not from the record,
       so they appear beside the name rather than as two more columns. #}
    {% set structure = chebi_structure(ing) %}
    {% if structure %}
      <div class="structure small muted">
        {% if structure.formula %}<span class="formula">{{ structure.formula }}</span>{% endif %}
        {% if structure.molecular_weight %}
          <span class="mass">{{ structure.molecular_weight }} g/mol</span>
        {% endif %}
      </div>
    {% endif %}
    {% if ing.supplier_catalog and ing.supplier_catalog.supplier_name %}
      <div class="supplier small muted">
        {{ ing.supplier_catalog.supplier_name }}
        {%- if ing.supplier_catalog.catalog_number %} {{ ing.supplier_catalog.catalog_number }}{% endif %}
      </div>
    {% endif %}
  </td>
  <td class="right">
    {{ quantity(ing.concentration) }}
  </td>
  <td>
    {% if ing.term and ing.term.id %}
      {{ ing.term.id|identifier_link }}
      <div class="muted small">{{ ing.term.label or '' }}</div>
    {% endif %}
  </td>
  <td class="prewrap small">{{ ing.notes or '' }}</td>
</tr>
{% endfor %}
</tbody>
</table>
{% else %}
<p class="muted"><em>No ingredients recorded.</em></p>
{% endif %}
</section>
