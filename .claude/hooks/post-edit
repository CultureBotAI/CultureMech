#!/usr/bin/env bash
# Publish edit activity only when fleet orchestration is explicitly configured.

orchestration_root="${KG_MICROBE_ORCHESTRATION_ROOT:-}"
if [ -z "$orchestration_root" ]; then
    echo "CultureMech status hook disabled: KG_MICROBE_ORCHESTRATION_ROOT is unset" >&2
    exit 0
fi

status_dir="$orchestration_root/status"
if [ ! -d "$status_dir" ]; then
    echo "CultureMech status hook error: directory not found at $status_dir" >&2
    exit 2
fi

timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
status_file="$status_dir/culturemech_claude_status.yaml"
cat > "$status_file" <<EOF
last_updated: '$timestamp'
status: busy
current_operation: file_edit
last_completed_operation: null
next_available_at: '$timestamp'
EOF
