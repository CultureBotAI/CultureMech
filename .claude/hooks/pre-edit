#!/usr/bin/env bash
# Block edits when the configured fleet lock checker says this repo is locked.

orchestration_root="${KG_MICROBE_ORCHESTRATION_ROOT:-}"
if [ -z "$orchestration_root" ]; then
    echo "CultureMech lock hook disabled: KG_MICROBE_ORCHESTRATION_ROOT is unset" >&2
    exit 0
fi

checker="$orchestration_root/scripts/check_lock.py"
if [ ! -f "$checker" ]; then
    echo "CultureMech lock hook error: checker not found at $checker" >&2
    exit 2
fi

python3 "$checker" culturemech "edit files"
result=$?
case "$result" in
    0) exit 0 ;;
    1)
        echo "Edit blocked by the CultureMech orchestration lock" >&2
        exit 1
        ;;
    *)
        echo "CultureMech lock check failed with exit $result; blocking edit" >&2
        exit 2
        ;;
esac
